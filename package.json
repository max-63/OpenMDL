{
  "name": "openmdl",
  "private": true,
  "version": "1.0.8",
  "description": "Logiciel de caisse & gestion de foyer open source pour la Maison des Lycéens (MDL)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:app": "tauri build",
    "build:appimage": "tauri build --bundles appimage",
    "build:deb": "tauri build --bundles deb",
    "build:rpm": "tauri build --bundles rpm",
    "build:win": "tauri build --target x86_64-pc-windows-gnu --bundles nsis",
    "build:all": "./build-all.sh"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/prismjs": "^1.26.6",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "chart.js": "^4.5.1",
    "lucide": "^1.45.0",
    "marked": "^18.0.13",
    "prismjs": "^1.30.0",
    "sucrase": "^3.35.1"
  }
}
