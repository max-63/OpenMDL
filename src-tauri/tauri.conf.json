{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMDL",
  "version": "1.0.2",
  "identifier": "fr.openmdl.foyer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMDL",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset:; font-src 'self' data:; connect-src 'self' https://api.sumup.com https://github.com https://objects.githubusercontent.com; frame-src 'self';"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3MjU5Nzk5NkI3OTZDRDYKUldUV2JIbHJtWmNsZHdkcjN6NFJtTnlkbDBTNlQ4SlNGeUd4WnZGK0MwakVWMk5STlJsbS9hanUK",
      "endpoints": [
        "https://github.com/max-63/OpenMDL/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Caisse & foyer pour Maison des Lycéens (MDL)",
    "longDescription": "OpenMDL est une application moderne et intuitive pour la gestion de caisse, stocks, terminaux TPE SumUp et comptabilité des foyers de lycéens.",
    "copyright": "Copyright © 2026 OpenMDL",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
